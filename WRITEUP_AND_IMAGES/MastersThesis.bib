@article{stach_alma_2018,
	title = {An {ALMA} survey of the {SCUBA}-2 {Cosmology} {Legacy} {Survey} {UKIDSS}/{UDS} field: number counts of submillimeter galaxies},
	volume = {860},
	issn = {0004-637X, 1538-4357},
	shorttitle = {An {ALMA} survey of the {SCUBA}-2 {Cosmology} {Legacy} {Survey} {UKIDSS}/{UDS} field},
	url = {http://arxiv.org/abs/1805.05362},
	doi = {10.3847/1538-4357/aac5e5},
	abstract = {We report the first results of AS2UDS: an 870 \${\textbackslash}mu\$m continuum survey with the Atacama Large Millimeter/Submillimeter Array (ALMA) of a total area of \${\textbackslash}sim\$ 50 arcmin\${\textasciicircum}2\$ comprising a complete sample of 716 submillimeter sources drawn from the SCUBA-2 Cosmology Legacy Survey (S2CLS) map of the UKIDSS/UDS field. The S2CLS parent sample covers a 0.96 degree\${\textasciicircum}2\$ field at \${\textbackslash}sigma\_\{850\}=0.90{\textbackslash}pm0.05\$ mJy beam\${\textasciicircum}\{-1\}\$. Our deep, high-resolution ALMA observations with \${\textbackslash}sigma\_\{{\textbackslash}rm 870\}{\textbackslash}sim\$ 0.25 mJy and a 0.15"--0.30" FWHM synthesized beam, provide precise locations for 695 submillimetre galaxies (SMGs) responsible for the submillimeter emission corresponding to 606 sources in the low resolution, single-dish map. We measure the number counts of SMGs brighter than \$S\_\{{\textbackslash}rm 870\}{\textbackslash}geq\$ 4 mJy, free from the effects of blending and show that the normalisation of the counts falls by 28 \${\textbackslash}pm\$ 2\% in comparison to the SCUBA-2 parent sample, but that the shape remains unchanged. We determine that 44\${\textasciicircum}\{+16\}\_\{-14\}\$\% of the brighter single-dish sources with \$S\_\{850\}{\textbackslash}geq\$ 9 mJy consist of a blend of two or more ALMA-detectable SMGs brighter than \$S\_\{870\}{\textbackslash}sim\$ 1 mJy (corresponding to a galaxy with a total-infrared luminosity of \$L\_\{IR\}{\textbackslash}geq\$ 10\${\textasciicircum}\{12\}\$ L\$\_{\textbackslash}odot\$), in comparison to 28 \${\textbackslash}pm\$ 2\% for the single-dish sources at \$S\_\{{\textbackslash}rm 850\}{\textbackslash}geq\$ 5 mJy. Using the 46 single-dish submillimeter sources that contain two or more ALMA-detected SMGs with photometric redshifts, we show that there is a significant statistical excess of pairs of SMGs with similar redshifts (\${\textless}\$1\% probability of occurring by chance), suggesting that at least 30\% of these blends arise from physically associated pairs of SMGs.},
	number = {2},
	urldate = {2025-09-16},
	journal = {The Astrophysical Journal},
	author = {Stach, S. M. and Smail, I. and Swinbank, A. M. and Simpson, J. M. and Geach, J. E. and An, F. X. and Almaini, O. and Arumugam, V. and Blain, A. W. and Chapman, S. C. and Chen, C.-C. and Conselice, C. J. and Cooke, E. A. and Coppin, K. E. K. and Dunlop, J. S. and Farrah, D. and Gullberg, B. and Hartley, W. and Ivison, R. J. and Maltby, D. T. and Michałowski, M. J. and Scott, D. and Simpson, C. and Thomson, A. P. and Wardlow, J. L. and Werf, P. van der},
	month = jun,
	year = {2018},
	note = {arXiv:1805.05362 [astro-ph]},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	pages = {161},
	annote = {Comment: 11 pages, 4 figures, fixed typo (sorry Rob)},
	file = {Full Text PDF:/Users/audreyburggraf/Zotero/storage/J9JFNPXX/Stach et al. - 2018 - An ALMA survey of the SCUBA-2 Cosmology Legacy Sur.pdf:application/pdf;Snapshot:/Users/audreyburggraf/Zotero/storage/CSLQWVHC/1805.html:text/html},
}

